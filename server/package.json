{
  "name": "gnbvg-server",
  "version": "1.0.0",
  "private": true,
  "description": "GNBVG Hostel Safety and Attendance Backend API Service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node index.js",
    "start:dist": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/tests/**/*.test.ts",
    "import-students": "tsx scripts/import-students.ts",
    "backup": "tsx scripts/backup-db.ts",
    "restore": "tsx scripts/restore-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@types/bcryptjs": "^2.4.6",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "gnbvg-hostel-system": "file:..",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "otplib": "^12.0.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
