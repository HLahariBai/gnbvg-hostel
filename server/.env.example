# ==============================================================================
# GNBVG HOSTEL SAFETY, ATTENDANCE & MOVEMENT MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Core Server Configuration
NODE_ENV=development
PORT=4000
TIMEZONE=Asia/Kolkata

# PostgreSQL Database Connections (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gnbvg_hostel?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gnbvg_hostel?schema=public"

# Redis Cache & Session Store
REDIS_URL="redis://localhost:6379"

# JSON Web Token (JWT) Secrets (Must be at least 32 characters each)
JWT_ACCESS_SECRET="gnbvg_production_access_token_secret_key_min_32_chars_2026"
JWT_REFRESH_SECRET="gnbvg_production_refresh_token_secret_key_min_32_chars_2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Cryptographic Keys
# AES-256-GCM 32-byte encryption key represented as a 64-character hexadecimal string
AES_256_GCM_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# HMAC Message Signing & Digital Gate Pass QR Verification Secrets
HMAC_SECRET="gnbvg_hmac_sha256_signing_secret_key_min_32_chars_2026"
QR_SIGNING_SECRET="gnbvg_gate_pass_qr_signing_secret_key_min_32_chars_2026"

# Institutional SMTP Configuration (GPREC Email Delivery for Dual-Channel OTP)
SMTP_HOST="smtp.gprec.ac.in"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="hostel-auth@gprec.ac.in"
SMTP_PASS="change_to_secure_smtp_password"
SMTP_FROM="\"GNBVG Hostel Administration\" <hostel-auth@gprec.ac.in>"

# Time-Based One-Time Password (TOTP) MFA Configuration
TOTP_SERVICE_NAME="GPREC-GNBVG-Hostel"

# GNBVG Hostel Geofence Coordinates & Quality Thresholds
HOSTEL_LATITUDE=15.8344
HOSTEL_LONGITUDE=78.0373
GEOFENCE_RADIUS_METERS=200
MAX_GPS_ACCURACY_METERS=50
MAX_GPS_AGE_SECONDS=60

# Attendance Operating Window & Reminder Defaults
DEFAULT_ATTENDANCE_START="17:00"
DEFAULT_ATTENDANCE_END="19:00"
DEFAULT_REMINDER_INTERVAL_MIN=15

# Security & CORS
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
